# Dashboard standalone - Deploy from root
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root package.json for workspaces
COPY package*.json ./

# Install all dependencies (workspaces)
RUN npm install

# Copy all source
COPY . .

ENV NEXT_PUBLIC_API_URL=https://proud-consideration-production-d69c.up.railway.app

# Build only the dashboard
RUN cd dashboard && npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV production

# Copy only dashboard build artifacts
COPY --from=builder /app/dashboard/public ./public
COPY --from=builder /app/dashboard/.next/standalone ./
COPY --from=builder /app/dashboard/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]

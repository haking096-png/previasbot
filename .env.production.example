# ==========================================================
#  CONFIGURAÇÃO DE PRODUÇÃO - COPIAR E PREENCHER ANTES DO DEPLOY
# ==========================================================
#
# INSTRUÇÕES:
# 1. Crie contas grátis em: neon.tech, upstash.com, vercel.com
# 2. Preencha os valores abaixo
# 3. Cole cada bloco nas variáveis de ambiente do serviço correspondente
#

# ==========================================================
# NEON POSTGRES (https://neon.tech)
# Banco de dados principal
# ==========================================================
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ==========================================================
# UPSTASH REDIS (https://upstash.com)
# Filas BullMQ + workers
# ==========================================================
REDIS_URL="rediss://default:xxx@xxx-12345.upstash.io:6379"
REDIS_HOST="xxx-12345.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-redis-password"


# ==========================================================
# BACKEND (Vercel Serverless OU Railway)
# ==========================================================
# Porta (Vercel ignora, Railway usa)
PORT=8080
NODE_ENV=production

# Senha do admin (mude para uma forte!)
ADMIN_PASSWORD="SuaSenhaForteAqui123!"

# JWT secret - GERE COM: openssl rand -hex 32
JWT_SECRET="cole-aqui-32-bytes-hex-gerados-com-openssl"


# ==========================================================
# TELEGRAM (https://t.me/BotFather)
# ==========================================================
# Token do bot (do @BotFather)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# Chat ID do canal onde vai publicar
TELEGRAM_CHAT_ID="-1001234567890"

# Link do CTA (geralmente link do próprio bot)
CTA_LINK="https://t.me/seubot?start=start"


# ==========================================================
# GROK / X.AI (https://console.x.ai)
# Geração automática de cópias
# ==========================================================
GROK_API_KEY="xai-sua-chave-aqui"
GROK_API_URL="https://api.x.ai/v1"

# Modelo padrão (pode sobrescrever por canal em Configurações)
GROK_MODEL_DEFAULT="grok-4-1-fast-non-reasoning"
GROK_MODEL_ANALYSIS="grok-4-1-fast-non-reasoning"
GROK_MODEL_PREVIEW="grok-4-1-fast-non-reasoning"
GROK_MODEL_ENQUETE="grok-4-1-fast-non-reasoning"
GROK_MODEL_CTA="grok-4-1-fast-non-reasoning"


# ==========================================================
# UPLOAD
# ==========================================================
UPLOADS_PATH="./uploads"
MAX_FILE_SIZE=10485760


# ==========================================================
# DASHBOARD (Vercel)
# Apenas uma variável é necessária: a URL do backend
# ==========================================================
NEXT_PUBLIC_API_URL="https://seu-backend.vercel.app"
# (NÃO coloque barra / no final!)

# ==========================================================
# AUTOMATION
# ==========================================================
AUTOMATION_ENABLED="true"

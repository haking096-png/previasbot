# ===========================================
# VARIÁVEIS DE AMBIENTE - RAILWAY PRODUCTION
# ===========================================
# Configure estas variáveis nos serviços backend e dashboard

# ===========================================
# BACKEND SERVICE
# ===========================================

# Database - Use a conexão do Postgres existente
# Obtenha em: Railway Dashboard > Postgres > Connect > Connection String
DATABASE_URL="postgresql://postgres:SUA_SENHA@SUA_HOST:5432/railway"

# Redis - Use a conexão do Redis existente
# Obtenha em: Railway Dashboard > Redis > Connect
REDIS_HOST="SUA_REDIS_HOST"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Backend
PORT=3001
NODE_ENV="production"
JWT_SECRET="telegram-preview-bot-jwt-secret-prod-2026"
ADMIN_PASSWORD="admin123"

# Telegram - Seu bot token (obtenha do @BotFather)
TELEGRAM_BOT_TOKEN="SEU_BOT_TOKEN"

# Chat ID do canal (obtenha do @userinfobot ou configure no dashboard)
TELEGRAM_CHAT_ID="SEU_CHAT_ID"

# Grok API (X.AI) - Sua chave da API
GROK_API_KEY="SUA_GROK_API_KEY"
GROK_API_URL="https://api.x.ai/v1"

# App Settings
CTA_LINK="https://t.me/seubot?start=start"
UPLOADS_PATH="./uploads"
MAX_FILE_SIZE=10485760

# CORS - URLs do dashboard em produção (será configurado automaticamente)
ALLOWED_ORIGINS="https://dashboard-production-XXXX.up.railway.app"

# ===========================================
# DASHBOARD SERVICE
# ===========================================

# URL do backend em produção (será configurado após deploy do backend)
NEXT_PUBLIC_API_URL="https://backend-production-XXXX.up.railway.app"

# ============================================
# DATABASE - Neon PostgreSQL
# ============================================
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================
# REDIS - Upstash
# ============================================
REDIS_URL="rediss://default:xxx@xxx-12345.upstash.io:6379"
REDIS_HOST="xxx-12345.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="your-redis-password"

# ============================================
# BACKEND
# ============================================
PORT=8080
NODE_ENV=production
JWT_SECRET="generate-with-openssl-rand-hex-32"
ADMIN_PASSWORD="your-secure-admin-password"

# ============================================
# TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-chat-id-or-channel-id"

# ============================================
# GROK API (X.AI)
# ============================================
GROK_API_KEY="xai-your-api-key"
GROK_API_URL="https://api.x.ai/v1"

# ============================================
# APP SETTINGS
# ============================================
CTA_LINK="https://t.me/yourbot"
UPLOADS_PATH="./uploads"
MAX_FILE_SIZE=10485760

# ============================================
# DASHBOARD (para o Next.js)
# ============================================
NEXT_PUBLIC_API_URL="https://api.telegram-preview-bot.up.railway.app"
